# Copy this file to `.env` and adjust for your environment.
# Only variables prefixed with VITE_ are exposed to the React bundle —
# everything else is backend-only and never reaches the browser.

# --- Frontend (Vite) ---------------------------------------------------------
# Set this in Vercel to the deployed API URL. The value here is a placeholder.
VITE_API_BASE_URL=https://your-render-service.onrender.com/api

# --- Backend API (server/) ---------------------------------------------------
PORT=5000
# Optional comma-separated additional CORS origins. The deployed storefront
# and localhost Vite origins are already allowed.
CORS_ORIGINS=
# Optional data directory override (defaults to server/data).
STORE_DATA_DIR=

# JWT signing secret — never commit a real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; leave empty only for local development.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Owner notification emails (SMTP — backend only) -------------------------
# Owner notifications are sent to this inbox.
OWNER_NOTIFICATION_EMAIL=owner@example.com

# SMTP provider settings. Leave EMAIL_HOST empty to run in development
# dry-run mode (email previews are logged instead of sent).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Optional "from" address; defaults to EMAIL_USER when empty.
EMAIL_FROM=
